# ==============================================================================
# VARIABLES DE ENTORNO PARA SUPABASE Y VERCEL (AGENDANDO)
# ==============================================================================

# 1. URL de tu proyecto en Supabase (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# 2. Clave anónima pública (Settings -> API -> Project API keys -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# 3. Clave de servicio / Admin (Settings -> API -> Project API keys -> service_role)
# Esta clave es privada y permite a los endpoints de Next.js leer/escribir datos de forma segura
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# 4. Clave secreta para firma de sesiones JWT (puedes inventar cualquier frase secreta)
SESSION_SECRET=agendando-super-clave-secreta-2026-woodland
